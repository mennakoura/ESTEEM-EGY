# generic stacked positive/negative contribution panel
function contrib_panel(t, contrib, names, colrs; ttl, ylab, withtotal=false)
    pos = max.(contrib, 0);  neg = min.(contrib, 0)
    pstack = cumsum(pos, dims=2);  nstack = cumsum(neg, dims=2)
    g = plot(title=ttl, ylabel=ylab, legend=:outerright,
             titlefontsize=10, legendfontsize=7)
    for j in 1:length(names)
        fp = j == 1 ? zeros(size(pstack,1)) : pstack[:, j-1]
        fn = j == 1 ? zeros(size(nstack,1)) : nstack[:, j-1]
        plot!(g, t, pstack[:, j], fillrange=fp, lw=0, color=colrs[j], label=names[j])
        plot!(g, t, nstack[:, j], fillrange=fn, lw=0, color=colrs[j], label="")
    end
    hline!(g, [0.0], color=:black, ls=:dash, label="")
    return g
end

