        cmat = hcat([sol0[cₐ[i]] for i in idx]...)        # baseline cₐ weights
        wts  = cmat ./ vec(sum(cmat, dims=2))
        pmat = hcat([sol[pᶠ[i]] for i in idx]...)
        vec(sum(wts .* pmat, dims=2))
    end for idx in group_idxs]...)
end
