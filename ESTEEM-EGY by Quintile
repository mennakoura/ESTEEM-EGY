using Plots, DifferentialEquations, LinearAlgebra, XLSX, ModelingToolkit, Printf

##############################################################
### ESTEEM Egypt - 67 Sectors, 5 Household Quintiles      ###
### Consumption: Linear Expenditure System                 ###
### Shock: Fuel subsidy removal + targeted cash transfer   ###
##############################################################

# =============================================================================
# 0) LOAD AND CLEAN IO DATA
# =============================================================================

path = pwd()
EGYHH = XLSX.readxlsx(string(path, "/Modelsheets.xlsx"))

clean(x) = x isa Number ? Float64(x) :
           (x isa String ? parse(Float64, replace(strip(x), "," => ".")) : 0.0)

ZZ     = clean.(EGYHH["IO"]["C6:BQ72"])
cc     = vec(clean.(EGYHH["IO"]["BS6:BS72"]) .+ clean.(EGYHH["IO"]["BW6:BW72"]))
xx     = vec(clean.(EGYHH["IO"]["CE6:CE72"]))
iK     = vec(clean.(EGYHH["IO"]["BY6:BY72"]))
gg     = vec(clean.(EGYHH["IO"]["BV6:BV72"]))
mm     = vec(clean.(EGYHH["IO"]["CG6:CG72"]))
nn     = vec(clean.(EGYHH["IO"]["C85:BQ85"]))
nn[nn .== 0] .= 1.0                            # guard against zero employment (division safety)??
tY_raw = vec(clean.(EGYHH["IO"]["C78:BQ78"])) .- vec(clean.(EGYHH["IO"]["C79:BQ79"])) #Actually production tax - production sub
#tM_raw = vec(clean.(EGY67["IO"]["C90:BQ90"])) # tM set to zero 
WW_sec = vec(clean.(EGYHH["IO"]["C77:BQ77"]))
#Removed scc_sec, changed for SCQ (loaded below)

# =============================================================================
# 1) AGGREGATE IO QUANTITIES AND PRICES
# =============================================================================

N = length(cc)   # 67 sectors
H = 5            # quintiles

yA     = vec(sum(ZZ, dims=2)) .+ cc .+ gg .+ iK
sigmaM = mm ./ yA
sigmaM[.!isfinite.(sigmaM)] .= 0.0
yy     = (1 .- sigmaM) .* yA .+ xx
AA     = ZZ * inv(diagm(yy))

# Tax RATES (REVISED)
tY = tY_raw ./ (yy .+ mm)       # net tax on products rate (but actually production taxes minus subsidies)
tM = zeros(N)                   # import tariff rates set to zero
tY[.!isfinite.(tY)] .= 0.0      # fix any division by zeros

pf      = (1 .+ tY) .* ((1 .- sigmaM) .+ sigmaM .* (1 .+ tM))
pC_base = sum(cc .* pf) / sum(cc)
ww      = WW_sec ./ yy
mu0     = vec(1 ./ (AA' * pf .+ ww) .- 1)
GOS_sec = (1 .- AA' * pf .- ww) .* yy

# Trade elasticities (REVISEDx2)
# Source: Eldeep & Zaki (2023)
# Range: σM ∈ [0.9,2.4], σX ∈ [1.5,3.0] 
ηᴹ_vec = vec(Float64.(EGYHH["Trade Elasticities EZ"]["E3:E69"]))  # η^M → imports
ηˣ_vec = vec(Float64.(EGYHH["Trade Elasticities EZ"]["G3:G69"]))  # η^X → exports
ζˣ_vec = xx ./ max.(1 .+ tY, 1e-4).^ηˣ_vec   
ζᴹ_vec = sigmaM .* max.(1 .+ tM, 1e-4).^(-ηᴹ_vec) 

# --- Additional calibration checks ---
println("mu0 range: ", round(minimum(mu0), digits=4), " to ", round(maximum(mu0), digits=4))
println("Negative mu0 sectors: ", sum(mu0 .< 0))
println("w initial range: ", round(minimum(WW_sec ./ nn), digits=2),
        " to ", round(maximum(WW_sec ./ nn), digits=2))
println("Any non-finite w: ", sum(.!isfinite.(WW_sec ./ nn)))

# ── mu0 diagnostic ────────────────────────────────────────────────────────
println("\n=== mu0 diagnostics ===")
println("Max mu0: ", round(maximum(mu0), digits=2), 
        "  Min mu0: ", round(minimum(mu0), digits=2))
println("Sectors with mu0 > 5:")
for i in 1:N
    if mu0[i] > 5
        println("  Sector $i: mu0=$(round(mu0[i],digits=2))",
                "  AA'pf=$(round((AA'*pf)[i],digits=4))",
                "  ww=$(round(ww[i],digits=4))",
                "  yy=$(round(yy[i]/1e6,digits=1)) bn EGP")
    end
end

println("Sectors with mu0 < -0.3:")
for i in 1:N
    if mu0[i] < -0.3
        println("  Sector $i: mu0=$(round(mu0[i],digits=2))",
                "  AA'pf=$(round((AA'*pf)[i],digits=4))",
                "  ww=$(round(ww[i],digits=4))")
    end
end

# more checks before proceeding
println("pf range: ", round(minimum(pf), digits=4), " to ", round(maximum(pf), digits=4),
        "  (reflects tax/subsidy structure — values below 1 indicate subsidised sectors)")
println("pC: ", round(pC_base, digits=4), "  (aggregate CPI including tax/subsidy distortions)")
println("GOS_sec sum: ", round(sum(GOS_sec) / 1e6, digits=1), " bn EGP")
println("GOS negative sectors: ", sum(GOS_sec .< 0))

# =============================================================================
# 2) HOUSEHOLD QUINTILE DATA
# =============================================================================
# CQ   : total consumption by sector × quintile (67×5, thousands EGP), not normalized
# POPQ : population by quintile (thousands), equal quintiles ~20,329 each
# THETAW: raw wage payments sector × quintile, row-normalized to get shares
# APIQ : profit ownership shares by quintile (sums to 1)
# SCQ  : social contribution rates by quintile (fractions of wage income)
# ETA_own: own-price elasticities by sector × quintile from Breisinger/IFPRI

CQ         = Float64.(EGYHH["CQ"]["B2:F68"])
POPQ       = vec(Float64.(EGYHH["POPQ"]["A2:E2"]))
THETAW_raw = Float64.(EGYHH["THETAW"]["B2:F68"])
row_sums_w = sum(THETAW_raw, dims=2)     # Normalised each row to sum to 1 (share of sector j's wage going to quintile h)
row_sums_w[row_sums_w .== 0] .= 1.0      # to avoid division by zero
THETAW     = THETAW_raw ./ row_sums_w    # wage SHARES — each row sums to 1

DISW       = THETAW_raw                  # unnormalized for profit scaling
APIQ       = vec(Float64.(EGYHH["APIQ"]["B5:F5"]))
SCQ        = vec(Float64.(EGYHH["SCQ"]["A8:E8"]))

ETA_own    = Float64.(EGYHH["Own-Price Elasticities (ηxh)"]["C2:G68"]) # Own-price elasticities by sector × quintile (N×H, from Breisinger/IFPRI)
println("Own-price elasticity sector 14 (petroleum): ", round.(ETA_own[14,:], digits=4))

# =============================================================================
# 2b) DERIVE THETAPI — sector × quintile profit distribution
# =============================================================================

APIQPERC = APIQ ./ sum(APIQ) # normalizing APIQ to shares summing to 1 (unnecessary)

# initial profit distribution (uniform across sector) scaled by APIQ
# DISPI[j,h] = GOS_sec[j] * APIQPERC[h]
DISPI    = GOS_sec * APIQPERC'
scaling  = (sum(DISPI, dims=1) ./ sum(DISPI)) ./ (sum(DISW, dims=1) ./ sum(DISW)) # wage-scaling correction to hh profit distribution 
THETAPI  = THETAW .* scaling
THETAPI ./= sum(THETAPI, dims=2)             # normalise rows to sum to 1
THETAPI[.!isfinite.(THETAPI)] .= 1.0 / H     # fix any zero-wage rows

# final profit distribution
DISPI    = GOS_sec .* THETAPI
DPI      = vec(sum(DISPI, dims=1))

println("=== Income distribution checks ===")
println("Total GOS:        ", round(sum(GOS_sec)/1e6, digits=1), " bn EGP")
println("Total DPI:        ", round(sum(DPI)/1e6,     digits=1), " bn EGP")
println("DPI by quintile:  ", round.(DPI ./ 1e6,      digits=1), " bn EGP")
println("THETAW row sums:  ", extrema(sum(THETAW,  dims=2)))  # should be (1,1)
println("THETAPI row sums: ", extrema(sum(THETAPI, dims=2)))  # should be (1,1)

# =============================================================================
# 3) QUINTILE-LEVEL INCOME AND PRICE CALIBRATION
# =============================================================================

DW    = vec(THETAW' * WW_sec)                              # Wage income by quintile: W_h = Σ_j THETAW[j,h] * WW_sec[j] (length-5)
YDH_h = ((1 .- SCQ) .* DW) .+ DPI                          # Disposable income per quintile: YDH_h = (1 - sc_h)*W_h + Π_h (length-5)
pCQ   = [ (CQ[:, h]' * pf) / sum(CQ[:, h]) for h in 1:H ]  # CPI by quintile: pCQ[h] = Σ_j CQ[j,h]*pf[j] / Σ_j CQ[j,h] (length-5)

println("\n=== Quintile income checks ===")
println("DW  (wage income, bn EGP):        ", round.(DW  ./ 1e6, digits=1))
println("DPI (profit income, bn EGP):      ", round.(DPI ./ 1e6, digits=1))
println("YDH (disposable income, bn EGP):  ", round.(YDH_h ./ 1e6, digits=1))
println("pCQ (quintile CPI, base≈1):       ", round.(pCQ, digits=4))
println("Aggregate CPI check: ", round(pC_base, digits=4),
        " vs weighted pCQ: ",
        round(sum(pCQ[h] * sum(CQ[:,h]) for h in 1:H) / sum(cc), digits=4))

println("\n=== Units consistency check ===")
println("Sum of cc  (IOT HH consumption):  ", round(sum(cc)/1e6,  digits=1), " bn EGP")
println("Sum of CQ  (all quintiles total): ", round(sum(CQ)/1e6,  digits=1), " bn EGP")
println("Sum DW+DPI (total factor income): ", round((sum(DW)+sum(DPI))/1e6, digits=1), " bn EGP")
println("Ratio DW+DPI / CQ (should be ~1.2-1.5 for savings): ",
        round((sum(DW)+sum(DPI)) / sum(CQ), digits=3))
println()
for h in 1:H
    cons_h    = sum(CQ[:, h])
    savings_h = 1 - cons_h / YDH_h[h]
    println("Q$h: YDH=", round(YDH_h[h]/1e6, digits=1),
            " bn  CQ=",  round(cons_h/1e6,    digits=1),
            " bn  implied savings rate=", round(savings_h*100, digits=1), "%")
end

# =============================================================================
# 4) LES CALIBRATION
# =============================================================================
cQ      = hcat([CQ[:, h] ./ POPQ[h] for h in 1:H]...)
YDreal0 = YDH_h ./ (POPQ .* pCQ)

C0_SH   = Float64.(EGYHH["Subsistence (c0_SH)"]["I4:M70"])
c0Q     = C0_SH .* cQ
c0Q_tot = vec(sum(c0Q, dims=1))

c1Q = zeros(N, H)
for h in 1:H
    price_adj = (pf ./ pCQ[h]) .^ ETA_own[:, h]
    price_adj[.!isfinite.(price_adj)] .= 1.0
    price_adj[price_adj .== 0] .= 1.0
    denom = (YDreal0[h] .- c0Q_tot[h]) .* price_adj
    denom[abs.(denom) .< 1e-10] .= 1e-10
    c1Q[:, h] = (cQ[:, h] .- c0Q[:, h]) ./ denom
end

price_adj_check = hcat([((pf ./ pCQ[h]) .^ ETA_own[:, h]) for h in 1:H]...)
price_adj_check[.!isfinite.(price_adj_check)] .= 1.0
Ctarg0 = POPQ' .* (c0Q .+ c1Q .* repeat((YDreal0 .- c0Q_tot)', N, 1) .* price_adj_check)

println("Aggregate subsistence share (%): ",
        round.(c0Q_tot ./ vec(sum(cQ,dims=1)) .* 100, digits=1))
println("Discretionary income (YD-c0Q_tot): ",
        round.(YDreal0 .- c0Q_tot, digits=2))
println("\n=== LES calibration checks ===")
println("Negative c0Q: ", sum(c0Q .< 0))
println("Negative c1Q: ", sum(c1Q .< 0))
println("c1Q column sums: ", round.(vec(sum(c1Q, dims=1)), digits=4))
println("max |CQ - Ctarg0| (must be ≈ 0): ", round(maximum(abs.(CQ .- Ctarg0)), digits=2))

# =============================================================================
# 5) DEFINE THE SYMBOLIC SYSTEM
# =============================================================================

@parameters βᶜ, βʷ, 
    βʸ[1:N], βᵖ[1:N],
    μ₁, γⁿ, λⁿ, nᵃ, eᴺ,
    ηˣ[1:N], ηᴹ[1:N],
    ζˣ[1:N], ζᴹ[1:N], pᵂ[1:N],
    A[1:N, 1:N], vᵈ[1:N], μ₀[1:N], a[1:N],
    g[1:N], iᴷ[1:N],
    tʸ[1:N], tᴹ[1:N],
    c⁰[1:N, 1:H], c¹[1:N, 1:H],
    cᵇ[1:N],
    cᵇʰ[1:N, 1:H],
    Popᴴ[1:H],
    Θʷ[1:N, 1:H],
    Θᵖ[1:N, 1:H],
    scᴴ[1:H],
    ηᴴ[1:N, 1:H],    # own-price elasticity by sector × quintile (Breisinger/IFPRI)
    στᴴ[1:H],        # transfer distribution weights by quintile
    στˢ,             # transfer size: fraction of GDP (δˢ=0) or fraction of extra revenue (δˢ=1)
    δˢ,              # fiscal saving mode: 1 = dynamic saving, 0 = fixed % GDP
    tʸʳᵉᶠ[1:N]       # reference (pre-shock) tax rates

@variables t,
    # Sector-level
    (yᴰ[1:N])(t), (y[1:N])(t), (yᵉ[1:N])(t), (yᴬ[1:N])(t),
    (v[1:N])(t),
    (x[1:N])(t), (σᴹ[1:N])(t), (m[1:N])(t),
    (μ[1:N])(t), (pᵇ[1:N])(t), (pᵈ[1:N])(t), (pᶠ[1:N])(t),
    (w[1:N])(t), (wᵈ[1:N])(t), (n[1:N])(t),
    (cₐ[1:N])(t),
    # Household-level (N×H matrices)
    (Cᴴ[1:N, 1:H])(t),
    (Wᴴ[1:H])(t),
    (Πᴴ[1:H])(t),
    (YDᴴ[1:H])(t),
    (pᶜᴴ[1:H])(t),
    # Aggregates
    (W)(t), (Π)(t), (YD)(t),
    (Tʸ)(t), (Tᴹ)(t), (SC)(t),
    NX(t), SG(t), SP(t),
    pᶜ(t), πₜ(t), yₜ(t), gₜ(t), gʸ(t), πʸ(t), nₜ(t), GDP(t), Invₜ(t),
   
    (ST)(t),        # aggregate social transfer
    (STᴴ[1:H])(t)   # social transfer by quintile (distributed by population share)

D = Differential(t)

eqs = vcat(

    # =========================================================================
    # PRODUCTIVE DYNAMICS
    # =========================================================================
    Symbolics.scalarize(yᴰ ~ yᴬ + x - m),
    Symbolics.scalarize(y  ~ yᵉ + vᵈ - v),
    Symbolics.scalarize(D.(v)  ~ y - yᴰ),
    Symbolics.scalarize(D.(yᵉ) ~ βʸ .* (yᴰ - yᵉ)),
    # Absorption = intermediate + government + investment + total HH consumption
    # cₐ[j] = Σ_h Popᴴ[h] * Cᴴ[j,h]  (aggregate from per-capita × population)
    Symbolics.scalarize(yᴬ ~ A * y + cₐ + g + iᴷ),
    Symbolics.scalarize(cₐ ~ Cᴴ * ones(H)),

    # =========================================================================
    # TRADE DYNAMICS
    # =========================================================================
    Symbolics.scalarize(x ~ ζˣ .* max.(pᵇ .* (1 .+ tʸ) ./ (pᵂ * eᴺ), 1e-8).^ηˣ),
    Symbolics.scalarize(σᴹ ~ ζᴹ .* max.(pᵇ ./ (pᵂ .* (1 .+ tᴹ) * eᴺ), 1e-8).^(-ηᴹ)),
    Symbolics.scalarize(m  ~ σᴹ .* yᴬ),

    # =========================================================================
    # HOUSEHOLD INCOME DISTRIBUTION
    # =========================================================================
    # Wage income:   Wᴴ[h] = Σ_j Θʷ[j,h] * w[j] * n[j]   # w[j]*y[j] = nominal wage bill of sector j (endogenous)
    # Profit income: Πᴴ[h] = Σ_j Θᵖ[j,h] * GOS[j]        # GOS[j] = (pᵇ[j] - A'*pᶠ[j] - w[j]) * y[j]
    vec(Symbolics.scalarize(Wᴴ ~ Θʷ' * (w .* n))),
    vec(Symbolics.scalarize(Πᴴ ~ Θᵖ' * ((pᵇ - A' * pᶠ - w ./ a) .* y))),
    # Aggregate totals 
    W  ~ sum(w .* n),
    Π  ~ sum((pᵇ - A' * pᶠ - w ./ a) .* y),
    YD ~ W + Π,

    # =========================================================================
    # LES CONSUMPTION DYNAMICS 
    # =========================================================================
    # Step 1: quintile-specific CPI
    vec(Symbolics.scalarize(pᶜᴴ ~ (cᵇʰ' * pᶠ) ./ vec(sum(cᵇʰ, dims=1)))),

    # Step 2: real per-capita disposable income
    # YDᴴ[h] = [(1-scᴴ[h])*Wᴴ[h] + Πᴴ[h] + STᴴ[h]] / (Popᴴ[h] * pᶜᴴ[h])
    vec(Symbolics.scalarize(YDᴴ ~ ((1 .- scᴴ) .* Wᴴ .+ Πᴴ .+ STᴴ) ./ (Popᴴ .* pᶜᴴ))),

    # Step 3: consumption adjustment toward LES target
    # ηᴴ = own-price elasticities from Breisinger/IFPRI (sector × quintile)
    # exp/log form avoids DomainError with negative bases
    vec(Symbolics.scalarize(D.(Cᴴ) ~ βᶜ .* (Popᴴ' .* (c⁰ .+ c¹ .* (YDᴴ' .- sum(c⁰, dims=1)) .*
    max.(pᶠ .* ones(N,H) ./ pᶜᴴ', 1e-8).^ηᴴ) .- Cᴴ))),

    # =========================================================================
    # WAGE DYNAMICS
    # =========================================================================
    # Desired wage grows with labour market tightness and inflation
    Symbolics.scalarize(D.(wᵈ) ~ exp(γⁿ * (nₜ / nᵃ - λⁿ)) * πʸ * wᵈ),
    Symbolics.scalarize(D.(w)  ~ βʷ * (wᵈ - w)),
    Symbolics.scalarize(n ~ y ./ a),

    # =========================================================================
    # GOVERNMENT
    # =========================================================================
    Symbolics.scalarize(Tʸ ~ (yᴰ .* pᵇ + m .* (1 .+ tᴹ) .* pᵂ * eᴺ)' * tʸ),
    Symbolics.scalarize(Tᴹ ~ (m .* pᵂ * eᴺ)' * tᴹ),
    SC ~ scᴴ' * Wᴴ,
    SG ~ Tʸ + Tᴹ + SC - g' * pᶠ - ST,

    # =========================================================================
    # PRICE DYNAMICS
    # =========================================================================
    Symbolics.scalarize(pᵈ ~ (1 .+ μ) .* (w ./ a + A' * pᶠ)),
    Symbolics.scalarize(D.(pᵇ) ~ βᵖ .* (pᵈ - pᵇ)),
    Symbolics.scalarize(μ ~ μ₀ + μ₁ * (vᵈ ./ max.(v, 1e-6) .- 1)),
    Symbolics.scalarize(pᶠ ~ (σᴹ .* (pᵂ .* (1 .+ tᴹ) * eᴺ) + (1 .- σᴹ) .* pᵇ) .* (1 .+ tʸ)),
    pᶜ ~ (cᵇ' * pᶠ) ./ sum(cᵇ),

    # =========================================================================
    # AGGREGATES
    # =========================================================================
    πₜ ~ D.(pᶜ) / pᶜ,
    yₜ ~ sum(y),
    gₜ ~ D.(yₜ) / yₜ,
    D.(gʸ) ~ gₜ - gʸ,
    D.(πʸ) ~ πₜ - πʸ,
    nₜ ~ sum(n),
    NX   ~ x' * (pᵇ .* (1 .+ tʸ)) - m' * (pᵂ * eᴺ),
    GDP  ~ (cₐ + g + iᴷ + x)' * pᵇ - m' * (pᵂ * eᴺ),
    # GDP is basic-price (pᵇ). It is used only as the denominator in the transfer
    # rule (ST) and as a plot scale — it is NOT an input to the Leontief block.
    # A market-price definition (final demand at pᶠ) would shift the absolute
    # transfer magnitude slightly; this is a second-order effect on a denominator.
    # S = I check: SP + SG - NX - Invₜ should = 0 at all times

    SP ~ sum(Popᴴ .* pᶜᴴ .* YDᴴ) - pᶠ' * cₐ,        # REVISED
    Invₜ ~ iᴷ' * pᶠ,

    # =========================================================================
    # SOCIAL TRANSFER,  Two modes selected by δˢ:
    # =========================================================================
    #   δˢ=0 (fixed):   ST = στˢ × GDP            → στˢ is transfer as a fraction of GDP
    #   δˢ=1 (dynamic): ST = στˢ × extra net product-tax revenue from the reform
    #   Transfer directed to bottom 40% via στᴴ = [0.5, 0.5, 0, 0, 0].
    ST ~ στˢ * ((1 - δˢ) * GDP + δˢ * sum((tʸ .- tʸʳᵉᶠ) .* (yᴰ .* pᵇ .+ m .* (1 .+ tᴹ) .* pᵂ * eᴺ))),
    vec(Symbolics.scalarize(STᴴ ~ ST .* στᴴ)),
)

@named ESTEEM_DAE = ODESystem(eqs, t)
@time ESTEEM_ODE = structural_simplify(ESTEEM_DAE)

# =============================================================================
# 6) NUMERICAL PARAMETER INSTANTIATION
# =============================================================================

# βʸ: output expectation adjustment speed (sector-specific) - Arbitrary
βʸ_vec = fill(3.0, N)
βʸ_vec[[1,2]]       .= 1.0   # Agriculture (slow, seasonal-constrained)
βʸ_vec[[3,4]]       .= 1.0   # Mining & oil/gas extraction (slow, capital-constrained)
βʸ_vec[[14,29,30]]  .= 1.0   # Petroleum refining, electricity, water (infrastructure)

# βᵖ: price adjustment speed (sector-specific)
# Source: IMF Philippines annex (Laurent), converted to continuous time (× 6)
βᵖ_vec = fill(2.0, N)              # default: Other Services
βᵖ_vec[[1,2]]         .= 6.0       # Agriculture
βᵖ_vec[5:28]          .= 3.0       # Manufacturing
βᵖ_vec[[3,14,29,30]]  .= 1.5       # Energy & Water (includes manufacture of petro-products)
βᵖ_vec[[4]]           .= 6.0       # Mining & Quarrying
βᵖ_vec[[31]]          .= 3.0       # Construction
βᵖ_vec[[33,34]]       .= 6.0       # Transport
βᵖ_vec[[35,53]]       .= 1.0       # Accommodation & Restaurants
βᵖ_vec[[36,38,39]]    .= 0.2       # IT & Communications
βᵖ_vec[[43,51]]       .= 2.0       # Real Estate
βᵖ_vec[[50,59]]       .= 1.5       # Human Health
βᵖ_vec[[58]]          .= 0.2       # Education

p = Dict(vcat(
    vec(collect(A    .=> AA)),
    vec(collect(vᵈ   .=> 0.1 * yy)),
    vec(collect(g    .=> gg)),
    vec(collect(iᴷ   .=> iK)),
    vec(collect(pᵂ   .=> ones(N) / 18.0)),                               # world price in EGP (≈ 18 EGP/USD)
   # vec(collect(ζˣ .=> ζˣ_vec)),
   # vec(collect(ζᴹ .=> ζᴹ_vec)),
    vec(collect(cᵇ   .=> cc)),                                           # aggregate CPI basket
    vec(collect(tʸ   .=> tY)),
    vec(collect(tᴹ   .=> tM)),
    vec(collect(μ₀   .=> mu0)),
    vec(collect(a    .=> yy ./ nn)),                                     # labour productivity
    # LES parameters
    vec(collect(c⁰   .=> c0Q)),                                          # subsistence per capita (67×5)
    vec(collect(c¹   .=> c1Q)),                                          # marginal budget shares (67×5)
    vec(collect(cᵇʰ  .=> CQ)),                                           # quintile CPI baskets (67×5)
    # Household distribution parameters
    vec(collect(Popᴴ .=> POPQ)),                                         # population (length-5)
    vec(collect(Θʷ   .=> THETAW)),                                       # wage shares (67×5)
    vec(collect(Θᵖ   .=> THETAPI)),                                      # profit shares (67×5)
    vec(collect(scᴴ  .=> SCQ)),                                          # scc rates (length-5)
    vec(collect(βʸ   .=> βʸ_vec)),                                       # REVISED expectation adjustment 
